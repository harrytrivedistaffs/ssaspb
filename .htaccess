# SSASPB
#
# The real Drupal webroot is the web/ subdirectory. On hosts where the
# subdomain's Document Root can't be (or isn't) pointed directly at web/,
# this serves the real site from web/ silently at the domain root — no
# visible redirect, no "/web/" ever shown in the address bar.
#
# This must be an INTERNAL rewrite, not a redirect. An earlier version of
# this file used a visible 302 redirect to /web/, which broke real content
# editing in production: browsers convert a redirected POST request into
# a GET, so any file upload or form submit that hit the redirect silently
# lost its data with no visible error.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Already resolved to web/ (e.g. Document Root is correctly set to web/
  # already, so this file is dormant, or a direct /web/... link was used).
  RewriteCond %{REQUEST_URI} ^/web/
  RewriteRule ^ - [L]

  RewriteRule ^(.*)$ web/$1 [L]
</IfModule>

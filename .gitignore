# Ignore directories generated by Composer
/drush/contrib/
/recipes/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings*.php
/web/sites/*/services*.yml

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore scaffold files
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.gitignore
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/README.txt
/web/autoload.php
/web/autoload_runtime.php
/bin
/composer.phar
/web/example.gitignore
/web/index.php
/web/modules/README.txt
/web/profiles/README.txt
/web/robots.txt
/web/sites/README.txt
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/themes/README.txt
/web/update.php
/web/web.config

# Ignore SimpleTest multi-site environment
/web/sites/simpletest

# Ignore Node dependencies (compiled CSS is committed, node_modules is not)
node_modules/

# Ignore IDE files
.idea/
.vscode/

# Ignore .env files as they are personal
/.env

# Ignore DB dumps, except the deliberate deploy snapshot in Deploy-Artifacts
*.sql
*.sql.gz
*.mysql
*.mysql.gz
!/Deploy-Artifacts/*.sql.gz

# Ignore temp files
/.phpunit.result.cache

# Ignore macOS DS_Store files
.DS_Store
**/.DS_Store
